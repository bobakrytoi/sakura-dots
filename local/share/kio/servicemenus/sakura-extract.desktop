[Desktop Entry]
Type=Service
MimeType=application/zip;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-tar;application/x-compressed-tar;application/x-zstd-compressed-tar;application/x-xz-compressed-tar;application/x-bzip2-compressed-tar;application/x-bzip-compressed-tar;application/gzip;application/x-xz;application/zstd;application/x-zip-compressed;application/java-archive;
X-KDE-Protocols=file
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Priority=TopLevel
Actions=extractHere;extractFolder;

[Desktop Action extractHere]
Name=Extract here
Name[ru]=Распаковать сюда
Icon=archive-extract
Exec=__HOME__/.config/hypr/scripts/archive.sh extract here %F

[Desktop Action extractFolder]
Name=Extract to folder
Name[ru]=Распаковать в папку
Icon=folder-download
Exec=__HOME__/.config/hypr/scripts/archive.sh extract folder %F
