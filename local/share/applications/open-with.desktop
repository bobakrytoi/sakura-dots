[Desktop Entry]
Type=Application
Name=Open With…
Comment=Pick an app to open the file
Exec=__HOME__/.local/bin/open-with %U
Icon=system-run
Terminal=false
Categories=Utility;
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/svg+xml;image/tiff;image/avif;image/heic;application/pdf;text/plain;text/html;video/mp4;video/x-matroska;audio/mpeg;audio/flac;audio/x-wav;application/zip;application/x-rar;application/octet-stream;
NoDisplay=false
StartupNotify=true
