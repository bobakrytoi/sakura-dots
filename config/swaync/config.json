{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 14,
  "notification-2fa-action": true,
  "notification-icon-size": 56,
  "notification-body-image-height": 120,
  "notification-body-image-width": 220,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "control-center-width": 400,
  "notification-window-width": 380,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 250,
  "hide-on-clear": false,
  "hide-on-action": true,
  "widgets": [
    "title",
    "buttons-grid",
    "volume",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear all"
    },
    "dnd": {
      "text": "Do not disturb"
    },
    "volume": {
      "label": "",
      "show-per-app": false
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "",
          "command": "kitty",
          "tooltip": "Terminal"
        },
        {
          "label": "",
          "command": "nautilus",
          "tooltip": "Files"
        },
        {
          "label": "",
          "command": "sh -c 'swaync-client -cp; sleep 0.4; ~/.config/hypr/scripts/screenshot.sh region'",
          "tooltip": "Screenshot"
        },
        {
          "label": "",
          "command": "sh -c 'swaync-client -cp; hyprpicker -a -n'",
          "tooltip": "Color picker"
        },
        {
          "label": "",
          "command": "sh -c 'swaync-client -cp; loginctl lock-session'",
          "tooltip": "Lock"
        },
        {
          "label": "",
          "command": "sh -c 'swaync-client -cp; ~/.config/hypr/scripts/powermenu.sh'",
          "tooltip": "Power"
        },
        {
          "label": "",
          "command": "sh -c 'swaync-client -cp; qs ipc call settings toggle'",
          "tooltip": "Settings"
        },
        {
          "label": "",
          "command": "sh -c 'swaync-client -cp; qs ipc call capture open'",
          "tooltip": "Capture"
        }
      ]
    }
  },
  "scripts": {
    "sakura-sound": {
      "exec": "__HOME__/.config/hypr/scripts/sfx.sh notify",
      "app-name": "^(?!(Screenshot|Capture)$).*$",
      "run-on": "receive"
    }
  },
  "script-fail-notify": false
}