{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "__HOME__/.config/fastfetch/logo.png",
    "width": 24,
    "height": 11,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "35",
      "title": "37"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{user-name-colored}\u001b[90m@\u001b[0m{host-name-colored}"
    },
    {
      "type": "custom",
      "format": "\u001b[90m─────────────────────────────"
    },
    {
      "type": "os",
      "key": "  󰣇",
      "keyColor": "35"
    },
    {
      "type": "kernel",
      "key": "  ",
      "keyColor": "35"
    },
    {
      "type": "wm",
      "key": "  ",
      "keyColor": "35"
    },
    {
      "type": "packages",
      "key": "  󰏖",
      "keyColor": "35"
    },
    {
      "type": "cpu",
      "key": "  ",
      "keyColor": "35"
    },
    {
      "type": "gpu",
      "key": "  󰍹",
      "keyColor": "35"
    },
    {
      "type": "memory",
      "key": "  ",
      "keyColor": "35"
    },
    {
      "type": "uptime",
      "key": "  ",
      "keyColor": "35"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}