// sakura mono — Capture overlay (Alt+Z), like the NVIDIA app: instant replay, recording, screenshot, settings
import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import Quickshell.Widgets
import QtQuick

Scope {
    id: cap

    readonly property color cBg:     "#ee0f1119"
    readonly property color cCard:   "#1a1d28"
    readonly property color cCard2:  "#14ffffff"
    readonly property color cHover:  "#252937"
    readonly property color cBorder: "#1fffffff"
    readonly property color cFg:     "#eceef4"
    readonly property color cMuted:  "#8a8fa3"
    readonly property color cAccent: "#f2b8d0"
    readonly property color cAccFg:  "#1a121a"
    readonly property color cRed:    "#f28fad"
    readonly property string fUi:    "Inter"
    readonly property string fIcon:  "Symbols Nerd Font"
    readonly property string home:   Quickshell.env("HOME")
    readonly property string script: home + "/.config/hypr/scripts/capture.sh"

    property bool shown: false
    property bool settingsOpen: false
    property bool replayOn: false
    property bool recordOn: false
    property int recordSecs: 0

    function toggle() { shown = !shown; if (shown) { pickScreen(); refresh(); } else settingsOpen = false; }
    function run(args) { Quickshell.execDetached([script].concat(args)); refreshSoon.restart(); }

    IpcHandler {
        target: "capture"
        function toggle(): void { cap.toggle(); }
        function open(): void { if (!cap.shown) cap.toggle(); }
        function close(): void { cap.shown = false; cap.settingsOpen = false; }
        function settings(): void { if (!cap.shown) cap.toggle(); cap.settingsOpen = true; }
    }

    // ── config ──────────────────────────────────────────────
    property var cfg: ({
        replaySeconds: 60, fps: 60, quality: "very_high", audio: "desktop", monitor: "focused",
        folder: "~/Videos/Clips", replayAutostart: true,
        hotkeys: { menu: "ALT + Z", replaySave: "ALT + SHIFT + F10", replayToggle: "ALT + SHIFT + F9",
                   record: "ALT + F9", screenshot: "ALT + F1" }
    })
    FileView {
        id: cfgFile
        path: cap.home + "/.config/capture/config.json"
        blockLoading: true
        watchChanges: true
        onFileChanged: reload()
        onLoaded: { try { cap.cfg = Object.assign({}, cap.cfg, JSON.parse(text())); } catch (e) {} }
    }
    function setCfg(k, v) { const c = Object.assign({}, cfg); c[k] = v; cfg = c; saveTimer.restart(); }
    function setKey(k, v) { const c = Object.assign({}, cfg); c.hotkeys = Object.assign({}, cfg.hotkeys); c.hotkeys[k] = v; cfg = c; saveTimer.restart(); }
    Timer { id: saveTimer; interval: 400; onTriggered: cap.save() }
    Process { id: bindProc }
    function save() {
        cfgFile.setText(JSON.stringify(cfg, null, 2));
        const h = cfg.hotkeys, s = script;
        const b = (key, cmd, desc) => key ? "hl.bind(\"" + key + "\", hl.dsp.exec_cmd(\"" + cmd + "\"), { desc = \"" + desc + "\", dont_inhibit = true })\n" : "";
        const lua = "-- generated by the Capture overlay (Alt+Z) — change hotkeys there\n" +
            b(h.menu, "qs ipc call capture toggle", "Capture overlay") +
            b(h.replaySave, s + " replay-save", "Save instant replay") +
            b(h.replayToggle, s + " replay-toggle", "Instant replay on/off") +
            b(h.record, s + " record-toggle", "Start/stop recording") +
            b(h.screenshot, home + "/.config/hypr/scripts/screenshot.sh screen", "Screenshot of the monitor");
        bindProc.command = ["sh", "-c",
            "cat > \"$HOME/.config/hypr/capture-binds.lua\" <<'EOF'\n" + lua + "EOF\nhyprctl reload >/dev/null; \"" + s + "\" apply"];
        bindProc.running = true;
    }

    // ── live status ─────────────────────────────────────────
    Process {
        id: statProc
        command: [cap.script, "json"]
        stdout: StdioCollector {
            onStreamFinished: { try { const j = JSON.parse(this.text); cap.replayOn = j.replay; cap.recordOn = j.record; cap.recordSecs = j.recordSeconds; } catch (e) {} }
        }
    }
    function refresh() { statProc.running = true; }
    Timer { interval: 1000; running: cap.shown; repeat: true; onTriggered: cap.refresh() }
    Timer { id: refreshSoon; interval: 700; onTriggered: cap.refresh() }

    property var screen0: Quickshell.screens[0]
    function pickScreen() {
        const m = Hyprland.focusedMonitor;
        const sc = m ? Quickshell.screens.find(s => s.name === m.name) : null;
        if (sc) screen0 = sc;
    }
    function fmt(t) { return String(Math.floor(t / 60)).padStart(2, "0") + ":" + String(t % 60).padStart(2, "0"); }
    function secLabel(s) { return s >= 60 ? (s / 60) + " min" : s + " s"; }

    // ── reusable bits ───────────────────────────────────────
    component Tile: Rectangle {
        id: tile
        property string icon: ""
        property string title: ""
        property string sub: ""
        property bool on: false
        property bool danger: false
        signal clicked()
        width: 170; height: 110; radius: 20
        color: on ? (danger ? "#33f28fad" : "#26f2b8d0") : (ta.containsMouse ? cap.cHover : cap.cCard)
        border.width: on ? 2 : 1
        border.color: on ? (danger ? cap.cRed : cap.cAccent) : cap.cBorder
        scale: ta.pressed ? 0.96 : 1
        Behavior on color { ColorAnimation { duration: 140 } }
        Behavior on scale { NumberAnimation { duration: 100 } }
        Column {
            anchors.centerIn: parent; spacing: 6
            Text { anchors.horizontalCenter: parent.horizontalCenter; text: tile.icon; font.family: cap.fIcon; font.pixelSize: 26
                color: tile.on ? (tile.danger ? cap.cRed : cap.cAccent) : cap.cFg }
            Text { anchors.horizontalCenter: parent.horizontalCenter; text: tile.title; color: cap.cFg; font.family: cap.fUi; font.pixelSize: 13; font.weight: Font.DemiBold }
            Text { anchors.horizontalCenter: parent.horizontalCenter; text: tile.sub; color: cap.cMuted; font.family: cap.fUi; font.pixelSize: 11 }
        }
        MouseArea { id: ta; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor; onClicked: tile.clicked() }
    }
    component Chip: Rectangle {
        id: chip
        property string text: ""
        property bool on: false
        signal clicked()
        width: ct.implicitWidth + 26; height: 32; radius: 10
        color: on ? cap.cAccent : (ca.containsMouse ? cap.cHover : cap.cCard2)
        Behavior on color { ColorAnimation { duration: 120 } }
        Text { id: ct; anchors.centerIn: parent; text: chip.text; color: chip.on ? cap.cAccFg : cap.cFg; font.family: cap.fUi; font.pixelSize: 12; font.weight: Font.DemiBold }
        MouseArea { id: ca; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor; onClicked: chip.clicked() }
    }
    component SettingRow: Item {
        id: sr
        property string label: ""
        default property alias content: holder.data
        width: parent ? parent.width : 0; height: 48
        Text { anchors { left: parent.left; verticalCenter: parent.verticalCenter } text: sr.label; color: cap.cFg; font.family: cap.fUi; font.pixelSize: 13 }
        Row { id: holder; anchors { right: parent.right; verticalCenter: parent.verticalCenter } spacing: 6 }
    }
    // click, then press a key combination
    component KeyField: Rectangle {
        id: kf
        property string value: ""
        property bool listening: false
        signal changed(string v)
        width: 190; height: 34; radius: 10
        color: listening ? "#26f2b8d0" : (kfa.containsMouse ? cap.cHover : cap.cCard2)
        border.width: listening ? 2 : 0; border.color: cap.cAccent
        Text { anchors.centerIn: parent; text: kf.listening ? "Press keys…" : (kf.value || "—")
            color: kf.listening ? cap.cAccent : cap.cFg; font.family: cap.fUi; font.pixelSize: 12; font.weight: Font.DemiBold }
        MouseArea { id: kfa; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
            onClicked: { kf.listening = true; kf.forceActiveFocus(); } }
        Keys.onPressed: e => {
            if (!kf.listening) return;
            e.accepted = true;
            if (e.key === Qt.Key_Escape) { kf.listening = false; return; }
            const mods = [];
            if (e.modifiers & Qt.MetaModifier) mods.push("SUPER");
            if (e.modifiers & Qt.ControlModifier) mods.push("CTRL");
            if (e.modifiers & Qt.AltModifier) mods.push("ALT");
            if (e.modifiers & Qt.ShiftModifier) mods.push("SHIFT");
            let k = "";
            if (e.key >= Qt.Key_F1 && e.key <= Qt.Key_F24) k = "F" + (e.key - Qt.Key_F1 + 1);
            else if (e.key === Qt.Key_Print) k = "Print";
            else if (e.key === Qt.Key_Space) k = "SPACE";
            else if (e.key === Qt.Key_Home) k = "Home";
            else if (e.key === Qt.Key_End) k = "End";
            else if (e.key === Qt.Key_Insert) k = "Insert";
            else if (e.key === Qt.Key_PageUp) k = "Prior";
            else if (e.key === Qt.Key_PageDown) k = "Next";
            else if (e.key >= Qt.Key_A && e.key <= Qt.Key_Z) k = String.fromCharCode(e.key);
            else if (e.key >= Qt.Key_0 && e.key <= Qt.Key_9) k = String.fromCharCode(e.key);
            if (!k) return;                       // only modifiers so far
            kf.listening = false;
            kf.changed(mods.concat([k]).join(" + "));
        }
    }

    // ── overlay ─────────────────────────────────────────────
    PanelWindow {
        id: win
        visible: cap.shown
        screen: cap.screen0
        anchors { top: true; bottom: true; left: true; right: true }
        exclusionMode: ExclusionMode.Ignore
        color: "transparent"
        WlrLayershell.layer: WlrLayer.Overlay
        WlrLayershell.namespace: "capture"
        WlrLayershell.keyboardFocus: WlrKeyboardFocus.Exclusive

        Rectangle {
            anchors.fill: parent
            color: "#99000000"
            opacity: cap.shown ? 1 : 0
            Behavior on opacity { NumberAnimation { duration: 180 } }
            MouseArea { anchors.fill: parent; onClicked: cap.toggle() }
        }

        Item {
            anchors.fill: parent
            focus: cap.shown
            Keys.onEscapePressed: cap.toggle()

            // top bar
            Rectangle {
                id: bar
                anchors { horizontalCenter: parent.horizontalCenter; top: parent.top; topMargin: 70 }
                width: tiles.implicitWidth + 48; height: 190; radius: 26
                color: cap.cBg; border.width: 1; border.color: cap.cBorder
                MouseArea { anchors.fill: parent }    // clicks inside don't close

                Row {
                    id: head
                    anchors { left: parent.left; top: parent.top; leftMargin: 24; topMargin: 16 }
                    spacing: 10
                    Text { text: "\uf03d"; font.family: cap.fIcon; font.pixelSize: 16; color: cap.cAccent; anchors.verticalCenter: parent.verticalCenter }
                    Text { text: "Capture"; color: cap.cFg; font.family: cap.fUi; font.pixelSize: 15; font.weight: Font.Bold; anchors.verticalCenter: parent.verticalCenter }
                    Rectangle {
                        visible: cap.recordOn || cap.replayOn
                        anchors.verticalCenter: parent.verticalCenter
                        width: st.implicitWidth + 16; height: 22; radius: 8
                        color: cap.recordOn ? "#33f28fad" : "#26f2b8d0"
                        Text { id: st; anchors.centerIn: parent; font.family: cap.fUi; font.pixelSize: 11; font.weight: Font.Bold
                            color: cap.recordOn ? cap.cRed : cap.cAccent
                            text: cap.recordOn ? "● REC " + cap.fmt(cap.recordSecs) : "Instant Replay on" }
                    }
                }
                Text {
                    anchors { right: parent.right; top: parent.top; rightMargin: 24; topMargin: 18 }
                    text: cap.cfg.hotkeys.menu + " to close"; color: cap.cMuted; font.family: cap.fUi; font.pixelSize: 11
                }

                Row {
                    id: tiles
                    anchors { horizontalCenter: parent.horizontalCenter; bottom: parent.bottom; bottomMargin: 22 }
                    spacing: 12
                    Tile {
                        icon: "\uf01e"; title: "Instant Replay"; on: cap.replayOn
                        sub: cap.replayOn ? "On · " + cap.secLabel(cap.cfg.replaySeconds) : "Off · " + cap.cfg.hotkeys.replayToggle
                        onClicked: cap.run(["replay-toggle"])
                    }
                    Tile {
                        icon: "\uf0c7"; title: "Save replay"; sub: cap.cfg.hotkeys.replaySave
                        opacity: cap.replayOn ? 1 : 0.45
                        onClicked: { if (cap.replayOn) { cap.run(["replay-save"]); cap.toggle(); } }
                    }
                    Tile {
                        icon: cap.recordOn ? "\uf04d" : "\uf111"; title: cap.recordOn ? "Stop recording" : "Record"
                        sub: cap.recordOn ? cap.fmt(cap.recordSecs) : cap.cfg.hotkeys.record
                        on: cap.recordOn; danger: true
                        onClicked: { cap.run(["record-toggle"]); if (!cap.recordOn) cap.toggle(); }
                    }
                    Tile {
                        icon: "\uf030"; title: "Screenshot"; sub: cap.cfg.hotkeys.screenshot
                        onClicked: { cap.toggle(); Quickshell.execDetached(["sh", "-c", "sleep 0.35; " + cap.home + "/.config/hypr/scripts/screenshot.sh screen"]); }
                    }
                    Tile {
                        icon: "\uf07c"; title: "Gallery"; sub: "open folder"
                        onClicked: { Quickshell.execDetached(["sh", "-c", "mkdir -p " + cap.cfg.folder + " && nautilus " + cap.cfg.folder]); cap.toggle(); }
                    }
                    Tile {
                        icon: "\uf013"; title: "Settings"; sub: ""; on: cap.settingsOpen
                        onClicked: cap.settingsOpen = !cap.settingsOpen
                    }
                }
            }

            // settings panel
            Rectangle {
                id: settings
                visible: cap.settingsOpen
                opacity: cap.settingsOpen ? 1 : 0
                Behavior on opacity { NumberAnimation { duration: 160 } }
                anchors { horizontalCenter: parent.horizontalCenter; top: bar.bottom; topMargin: 14 }
                width: bar.width; height: Math.max(setCol.implicitHeight, keyCol.implicitHeight) + 48; radius: 26
                color: cap.cBg; border.width: 1; border.color: cap.cBorder
                MouseArea { anchors.fill: parent }

                Row {
                    anchors { fill: parent; margins: 24 }
                    spacing: 32
                    Column {
                        id: setCol
                        width: (parent.width - 32) / 2
                        Text { text: "Video"; color: cap.cAccent; font.family: cap.fUi; font.pixelSize: 12; font.weight: Font.Bold; bottomPadding: 4 }
                        SettingRow { label: "Replay length"
                            Repeater { model: [15, 30, 60, 120, 300]
                                delegate: Chip { required property int modelData; text: cap.secLabel(modelData); on: cap.cfg.replaySeconds === modelData
                                    onClicked: cap.setCfg("replaySeconds", modelData) } } }
                        SettingRow { label: "Frame rate"
                            Repeater { model: [30, 60, 120, 200]
                                delegate: Chip { required property int modelData; text: modelData + " fps"; on: cap.cfg.fps === modelData
                                    onClicked: cap.setCfg("fps", modelData) } } }
                        SettingRow { label: "Quality"
                            Repeater { model: [ { v: "medium", t: "Medium" }, { v: "high", t: "High" }, { v: "very_high", t: "Very high" }, { v: "ultra", t: "Ultra" } ]
                                delegate: Chip { required property var modelData; text: modelData.t; on: cap.cfg.quality === modelData.v
                                    onClicked: cap.setCfg("quality", modelData.v) } } }
                        SettingRow { label: "Audio"
                            Repeater { model: [ { v: "desktop", t: "Game/PC" }, { v: "desktop+mic", t: "PC + mic" }, { v: "mic", t: "Mic" }, { v: "none", t: "None" } ]
                                delegate: Chip { required property var modelData; text: modelData.t; on: cap.cfg.audio === modelData.v
                                    onClicked: cap.setCfg("audio", modelData.v) } } }
                        SettingRow { label: "Monitor"
                            Repeater { model: [ { v: "focused", t: "Active" }, { v: "DP-3", t: "Left" }, { v: "DP-1", t: "Right" } ]
                                delegate: Chip { required property var modelData; text: modelData.t; on: cap.cfg.monitor === modelData.v
                                    onClicked: cap.setCfg("monitor", modelData.v) } } }
                        SettingRow { label: "Replay on at login"
                            Chip { text: cap.cfg.replayAutostart ? "On" : "Off"; on: cap.cfg.replayAutostart
                                onClicked: cap.setCfg("replayAutostart", !cap.cfg.replayAutostart) } }
                    }
                    Column {
                        id: keyCol
                        width: (parent.width - 32) / 2
                        Text { text: "Hotkeys  ·  click a field, then press keys"; color: cap.cAccent; font.family: cap.fUi; font.pixelSize: 12; font.weight: Font.Bold; bottomPadding: 4 }
                        SettingRow { label: "Open this menu"
                            KeyField { value: cap.cfg.hotkeys.menu; onChanged: v => cap.setKey("menu", v) } }
                        SettingRow { label: "Save instant replay"
                            KeyField { value: cap.cfg.hotkeys.replaySave; onChanged: v => cap.setKey("replaySave", v) } }
                        SettingRow { label: "Instant replay on/off"
                            KeyField { value: cap.cfg.hotkeys.replayToggle; onChanged: v => cap.setKey("replayToggle", v) } }
                        SettingRow { label: "Start/stop recording"
                            KeyField { value: cap.cfg.hotkeys.record; onChanged: v => cap.setKey("record", v) } }
                        SettingRow { label: "Screenshot"
                            KeyField { value: cap.cfg.hotkeys.screenshot; onChanged: v => cap.setKey("screenshot", v) } }
                        Text { text: "Save folder"; color: cap.cAccent; font.family: cap.fUi; font.pixelSize: 12; font.weight: Font.Bold; topPadding: 10; bottomPadding: 6 }
                        Rectangle {
                            width: parent.width; height: 38; radius: 10; color: cap.cCard2
                            border.width: folderIn.activeFocus ? 2 : 0; border.color: cap.cAccent
                            TextInput {
                                id: folderIn
                                anchors { fill: parent; leftMargin: 12; rightMargin: 12 }
                                verticalAlignment: TextInput.AlignVCenter
                                text: cap.cfg.folder; color: cap.cFg; font.family: cap.fUi; font.pixelSize: 13
                                selectionColor: cap.cAccent; clip: true
                                onEditingFinished: if (text !== cap.cfg.folder) cap.setCfg("folder", text)
                            }
                        }
                        Text { text: "Replays → " + cap.cfg.folder + "/Replays   ·   Recordings → " + cap.cfg.folder + "/Recordings"
                            color: cap.cMuted; font.family: cap.fUi; font.pixelSize: 11; topPadding: 6; width: parent.width; wrapMode: Text.WordWrap }
                    }
                }
            }
        }
    }
}
