#version 300 es
// sakura mono color correction — generated by the Settings app
precision highp float;
in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;

const float VIBRANCE = 0.35;   // like NVIDIA Digital Vibrance: boosts dull colors more than vivid ones
const float CONTRAST = 0.06;   // gentle S-curve
const float WARMTH   = 0.00;   // night light (0 = off)

void main() {
    vec4 c = texture(tex, v_texcoord);
    vec3 col = c.rgb;

    // vibrance
    float luma = dot(col, vec3(0.2126, 0.7152, 0.0722));
    float sat  = max(col.r, max(col.g, col.b)) - min(col.r, min(col.g, col.b));
    col = mix(vec3(luma), col, 1.0 + VIBRANCE * (1.0 - sat));

    // contrast around mid-grey
    col = (col - 0.5) * (1.0 + CONTRAST) + 0.5;

    // warmth
    col *= vec3(1.0, 1.0 - WARMTH * 0.18, 1.0 - WARMTH * 0.45);

    fragColor = vec4(clamp(col, 0.0, 1.0), c.a);
}
