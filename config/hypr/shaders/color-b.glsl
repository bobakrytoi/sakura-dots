#version 300 es
// generated by the Settings app
precision highp float;
in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;
const float VIBRANCE = 1.000;
const float CONTRAST = 0.140;
const float WARMTH = 0.000;
const float BRIGHTNESS = 0.010;
const float GAMMA = 1.300;
void main() {
  vec4 c = texture(tex, v_texcoord); vec3 col = c.rgb;
  float luma = dot(col, vec3(0.2126, 0.7152, 0.0722));
  float sat = max(col.r, max(col.g, col.b)) - min(col.r, min(col.g, col.b));
  col = mix(vec3(luma), col, 1.0 + VIBRANCE * (1.0 - sat));
  col = (col - 0.5) * (1.0 + CONTRAST) + 0.5;
  col *= vec3(1.0, 1.0 - WARMTH * 0.18, 1.0 - WARMTH * 0.45);
  col = clamp(col + BRIGHTNESS, 0.0, 1.0);
  col = pow(col, vec3(1.0 / GAMMA));
  fragColor = vec4(clamp(col, 0.0, 1.0), c.a);
}
