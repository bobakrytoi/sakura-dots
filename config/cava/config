# sakura mono — cava in the terminal
[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1
autosens = 1

[input]
method = pipewire
source = auto

[output]
method = noncurses

[color]
gradient = 1
gradient_count = 4
gradient_color_1 = '#b9a6ff'
gradient_color_2 = '#d6b0f0'
gradient_color_3 = '#f2b8d0'
gradient_color_4 = '#ffd6e6'

[smoothing]
noise_reduction = 77
monstercat = 1
waves = 0
