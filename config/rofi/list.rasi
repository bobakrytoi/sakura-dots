@import "config.rasi"
configuration { show-icons: false; }
window   { width: 760px; height: 560px; }
mainbox  { orientation: vertical; children: [ imagebox, listbox ]; }
imagebox {
    width: 100%; height: 150px; expand: false;
    background-image: url("~/.config/rofi/images/list.jpg", width);
    border-radius: 22px 22px 0 0;
    children: [ ];
}
listbox  { children: [ inputbar, listview ]; }
prompt   { font: "Inter SemiBold 12"; }
listview { lines: 8; }
element-text { font: "JetBrainsMono Nerd Font 11"; }
