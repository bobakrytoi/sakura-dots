@import "colors.rasi"
configuration { show-icons: false; font: "Inter Medium 12"; hover-select: true; me-select-entry: ""; me-accept-entry: "MousePrimary"; }
window {
    width: 640px; border: 1px; border-color: @border-c; border-radius: 26px;
    background-color: @bg; padding: 0;
}
mainbox  { children: [ imagebox, listview ]; background-color: transparent; spacing: 0; }
imagebox {
    height: 150px; expand: false; padding: 18px 22px;
    background-image: url("~/.config/rofi/images/power.jpg", width);
    children: [ dummy, prompt ];
}
dummy { expand: true; background-color: transparent; }
prompt {
    background-color: #0e0e10b3; text-color: @fg; padding: 6px 12px; border-radius: 10px;
    expand: false; horizontal-align: 0; font: "Inter SemiBold 11";
}
listview {
    columns: 5; lines: 1; spacing: 12px; padding: 22px;
    fixed-columns: true; background-color: transparent; layout: vertical;
}
element {
    padding: 15px 0 29px 0; border-radius: 18px; background-color: @surface2; text-color: @fg; cursor: pointer;
}
element-text {
    font: "Symbols Nerd Font 26"; horizontal-align: 0.5; vertical-align: 0.5;
    background-color: transparent; text-color: inherit; cursor: inherit;
}
element selected.normal { background-color: @accent; text-color: @accent-fg; }
